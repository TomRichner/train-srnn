# GCP Configuration (GPU pipeline — L4 on g2-standard-8)
GCP_PROJECT="liquidneuralnets"
GCP_ZONE="${GCP_ZONE:-us-central1-b}"       # L4 zones: -a, -b, -c (NOT -f). Capacity shifts zone to zone — override with `GCP_ZONE=us-central1-a ./cloud/launch_run_gpu.sh ...`.
GCP_BUCKET="gs://liquidneuralnets-experiments"
GCP_USE_SPOT=false                          # spot ~65% cheaper, better L4 availability
REPO_URL="git@github.com:TomRichner/train-srnn.git"   # ssh URLs use the Secret Manager deploy key; https needs none

# Use Google's Deep Learning VM image (no custom image build needed).
# Pre-installed: torch 2.9+cu129, CUDA 12.9, NVIDIA driver 580, Ubuntu 22.04.
# (GCP deprecates older DLVM family names; keep this current — check with
#  `gcloud compute images list --project=deeplearning-platform-release --filter='family~pytorch'`.)
GCP_IMAGE_FAMILY="pytorch-2-9-cu129-ubuntu-2204-nvidia-580"
GCP_IMAGE_PROJECT="deeplearning-platform-release"
# Pascal fallback (P4, P100): driver 580 ships open kernel module → only
# supports Turing+ (sm_75+). To use Pascal GPUs, swap to the deprecated 570
# image (still launchable by exact name, no SLA — verify it still exists with
# `gcloud compute images describe <name> --project=deeplearning-platform-release`):
#   GCP_IMAGE_FAMILY=""  # unset family
#   GCP_IMAGE_NAME="pytorch-2-7-cu128-ubuntu-2204-nvidia-570-v20260320"
# launch_run_gpu.sh would need a small tweak to prefer --image over
# --image-family when GCP_IMAGE_NAME is set.

# VM Configuration. All env-var overridable so a caller can swap GPU/host
# without editing this file, e.g. T4 fallback when L4 is stocked out:
#   GPU_TYPE=nvidia-tesla-t4 DEFAULT_MACHINE_TYPE_FAMILY=n1 \
#     ./cloud/launch_run_gpu.sh ...
DEFAULT_MACHINE_TYPE_FAMILY="${DEFAULT_MACHINE_TYPE_FAMILY:-g2}"
DEFAULT_MACHINE_TIER="${DEFAULT_MACHINE_TIER:-standard-8}"   # 1× L4, 8 vCPU, 32 GB RAM
GPU_TYPE="${GPU_TYPE:-nvidia-l4}"
GPU_COUNT="${GPU_COUNT:-1}"
BOOT_DISK_SIZE="${BOOT_DISK_SIZE:-100GB}"                     # DLVM image requires ≥100 GB
BOOT_DISK_TYPE="${BOOT_DISK_TYPE:-pd-balanced}"               # g2 does not support hyperdisk-balanced

# Concurrency — bound by GPU quota, not disk. Regional L4 quota starts at 1.
MAX_CONCURRENT_VMS=1

# Experiment matrix — narrower than CPU; excludes discrete models (lstm, ctgru)
# and LTC variants that don't benefit from GPU matmul. Override with --models.
ALL_MODELS="srnn srnn_per_neuron srnn_echo srnn_no_adapt srnn_no_adapt_no_dales srnn_sfa_only srnn_std_only srnn_e_only srnn_e_only_echo srnn_e_only_per_neuron"
ALL_EXPERIMENTS="har gesture occupancy smnist traffic power ozone person cheetah"
