# All model/task knobs live in conf/task/cheetah100.yaml — keep ARGS minimal so
# the YAML stays the single source of truth (cf. seeg.env). In particular do NOT
# set size/batch_size here: cheetah.env's "size=32 batch_size=16" is what
# silently overrode those on the older windowed cheetah runs.
ARGS="epochs=60"
MACHINE_TIER=standard-8
N_SEEDS=1
