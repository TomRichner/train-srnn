# All model/task knobs live in conf/task/cheetah100.yaml — keep ARGS minimal so
# the YAML stays the single source of truth (cf. seeg.env). In particular do NOT
# set size/batch_size here: cheetah.env's "size=32 batch_size=16" is what
# silently overrode those on the older windowed cheetah runs.
#
# Continuous ring runs pass their own overrides on the command line (Hydra is
# last-wins, so the epochs=60 below is superseded).
#
# ring6-400e (2026-08-27, K=6, 400 epochs, 2h43m on one L4):
#   ./cloud/launch_run_gpu.sh --cleanup=stop run ring6-400e cheetah100 srnn 1 \
#       "batched_ablations=[srnn-no-adapt-no-dales,srnn-no-adapt,srnn-no-dales-skip,\
#        srnn-no-adapt-no-dales-skip,srnn,srnn-skip] epochs=400"
#
# ring2x5-100e — adaptation vs no-adaptation at 5 seeds each (K=10 in one batch).
# The two variants at a given seed share one RMTMatrix, so each of the 5 pairs is
# matched on recurrent connectivity; seeds are encoded in the variant names as
# "<variant>-seed<n>" (train_srnn/models/factory.py).
#   ./cloud/launch_run_gpu.sh --cleanup=stop run ring2x5-100e cheetah100 srnn 1 \
#       "batched_ablations=[srnn-no-dales-skip,srnn-no-adapt-no-dales-skip] \
#        batched_ablation_seeds=[1,2,3,4,5] epochs=100 checkpoint_interval=5 \
#        warmup_epochs=3"
# checkpoint_interval=5 also sets the eval/CSV cadence (log_interval defaults to
# it), so the learning curves land on 5, 10, ..., 100 instead of the round(B/4)=6
# default that gave ring6-400e its 6/12/18 spacing.
# warmup_epochs=3 with cosine_decay=false (the default) means LR ramps to
# cfg.lr over 3 epochs and then holds constant for the remaining 97.
ARGS="epochs=60"
MACHINE_TIER=standard-8
N_SEEDS=1
