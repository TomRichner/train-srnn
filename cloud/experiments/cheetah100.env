# Default train.py overrides for cheetah100 dispatches. Keep ARGS minimal so
# the task config (train_srnn/config.py) stays authoritative; runs pass their
# own overrides on the command line (Hydra is last-wins).
#
# ring6-400e (K=6, 400 epochs, 2h43m on one L4):
#   ./cloud/launch_run_gpu.sh --cleanup=stop ring6-400e cheetah100 srnn 1 \
#       "model.variants=[srnn-no-adapt-no-dales,srnn-no-adapt,srnn-no-dales-skip,\
#        srnn-no-adapt-no-dales-skip,srnn,srnn-skip] epochs=400"
#
# ring2x5-100e: adaptation vs no adaptation at 5 recurrent seeds each (K=10).
# Variants sharing a seed share one recurrent matrix, so the 5 pairs are
# matched on connectivity; names become "<variant>-seed<n>".
#   ./cloud/launch_run_gpu.sh --cleanup=stop ring2x5-100e cheetah100 srnn 1 \
#       "model.variants=[srnn-no-dales-skip,srnn-no-adapt-no-dales-skip] \
#        model.variant_seeds=[1,2,3,4,5] epochs=100 checkpoint_interval=5 warmup_epochs=3"
# checkpoint_interval also sets the eval/CSV cadence; warmup_epochs=3 with
# cosine_decay=false ramps the LR over 3 epochs and then holds it.
ARGS="epochs=60"
