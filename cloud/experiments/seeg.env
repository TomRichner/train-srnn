EXPERIMENT_NAME=seeg
# All seeg-specific knobs (h, ode_unfolds, decimate, seq_len, stride,
# window_len, bptt_len, bptt_chunk_len, loss_over_bptt, no_augment,
# stretch_lo/hi, batch_size, train_trace_max_len) now live in
# conf/task/seeg.yaml — no CLI overrides needed for default behavior:
#   ./cloud/launch_run.sh run seeg srnn 1
# To run with continuous-batching trainer on the SEEG trace ring:
#   ./cloud/launch_run_gpu.sh --cleanup=keep run seeg srnn 1 \
#       "epochs=100 continuous_train=true lr=1e-4 \
#        batched_ablations=[srnn-e-only-per-neuron,...]"
ARGS="epochs=100"
MACHINE_TIER=standard-8
N_SEEDS=3
