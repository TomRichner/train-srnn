EXPERIMENT_NAME=seeg
# Data: 500 Hz -> 250 Hz (pair-average). Window: 5 s warmup + 10 s predict,
# 5 s stride (consecutive predict regions overlap 50%).
# No augment: real biological time series.
# Burn-in: inherit global defaults (burn_in=10.0, burn_in_every=1,
# freeze_ic_after_burnin=true) — 10 s unforced burn-in into the IC, refreshed
# each epoch to track the moving fixed point as weights drift (KnownIssues §4).
# TBPTT: bptt_chunk_len=125 detaches state every 0.5 s inside the grad
# region; loss_over_bptt=true averages MSE across all 2500 one-step-ahead
# predictions. Single backward per batch; grad depth <=125 cell steps.
# ODE convention: h=1/250=0.004 s makes taus in real seconds at the 250 Hz
# post-decimate rate. h and ode_unfolds=1 are now defaults from
# conf/task/seeg.yaml (and SRNN/NODE/LTC model YAMLs interpolate them via
# ${task.h} / ${task.ode_unfolds}), so no CLI override is needed:
#   ./cloud/launch_run.sh run seeg srnn 1
ARGS="epochs=100 size=256 batch_size=12 window_len=3750 bptt_len=2500 bptt_chunk_len=125 loss_over_bptt=true stretch_lo=1.0 stretch_hi=1.0 no_augment=true"
MACHINE_TIER=standard-8
N_SEEDS=3
