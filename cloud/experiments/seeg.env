EXPERIMENT_NAME=seeg
# Data: 500 Hz -> 250 Hz (pair-average). Window: 5 s warmup + 10 s predict,
# 5 s stride (consecutive predict regions overlap 50%).
# ODE: h=1/250=0.004 s so taus are in real seconds. ode_unfolds=1 keeps
# compute down; dt=4 ms is well under shortest tau inits (~5-100 ms).
# Solver: semi_implicit (A-stable, ~3-4x cheaper than rk4). Consider a
# follow-up rk4 run (model.solver=rk4) for a numerical-baseline checkpoint.
# No augment: real biological time series.
ARGS="epochs=100 size=256 batch_size=12 window_len=3750 bptt_len=2500 stretch_lo=1.0 stretch_hi=1.0 no_augment=true burn_in=0.0 model.h=0.004 model.ode_unfolds=1"
MACHINE_TIER=standard-8
N_SEEDS=3
